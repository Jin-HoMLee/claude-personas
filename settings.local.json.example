# settings.local.json.example
#
# This file goes inside each PROJECT worktree (not inside claude-personas).
# claude-personas itself is cloned once — its role folders (developer/, pm/,
# designer/) are referenced by absolute path from your project worktrees.
#
# Copy this file to .claude/settings.local.json inside each project worktree
# you want a role for, then change autoMemoryDirectory to the absolute path
# of the matching role folder inside your claude-personas clone.
#
# One settings.local.json per project worktree — each pointing at a different role.
# Do NOT commit .claude/settings.local.json — it contains machine-specific paths.
#
# Examples (assume claude-personas is cloned to /Users/you/projects/claude-personas):
#   In your-project/         (developer worktree) → autoMemoryDirectory: ".../claude-personas/developer"
#   In your-project-pm/      (PM worktree)        → autoMemoryDirectory: ".../claude-personas/pm"
#   In your-project-designer/ (designer worktree) → autoMemoryDirectory: ".../claude-personas/designer"

{
  "autoMemoryDirectory": "/absolute/path/to/claude-personas/developer"
}
